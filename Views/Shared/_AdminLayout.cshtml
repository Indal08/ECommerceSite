<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" />
    <style>
        body { background-color: #f4f1ec; }
        .admin-topbar { background-color: var(--brand-dark); }
        .admin-shell { display: flex; min-height: 100vh; }
        .admin-sidebar {
            width: 220px;
            background-color: #fff;
            border-right: 1px solid rgba(0,0,0,0.07);
            padding: 20px 0;
            flex-shrink: 0;
        }
        .admin-sidebar .list-group-item {
            border: none;
            padding: 10px 22px;
            font-weight: 500;
            color: var(--brand-dark);
        }
        .admin-sidebar .list-group-item.active {
            background-color: var(--brand-accent-light);
            color: var(--brand-primary);
            font-weight: 600;
        }
        .admin-main { flex: 1; padding: 28px; max-width: 100%; }
        @@media (max-width: 767px) {
            .admin-sidebar { display: none; }
            .admin-main { padding: 18px; }
        }
    </style>
</head>
<body>
    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    }
    <nav class="navbar navbar-dark admin-topbar px-3">
        <button class="btn btn-outline-light d-md-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar">
            &#9776;
        </button>
        <span class="navbar-brand ms-2 mb-0">🐷 Admin Panel</span>
        <form asp-controller="Account" asp-action="Logout" method="post" class="ms-auto">
            <button type="submit" class="btn btn-sm btn-outline-light">Logout</button>
        </form>
    </nav>

    <div class="offcanvas offcanvas-start d-md-none" tabindex="-1" id="adminSidebar">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title">Menu</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body p-0">
            <div class="list-group list-group-flush">
                <a class="list-group-item list-group-item-action @(currentAction == "Index" ? "active" : "")" asp-controller="Admin" asp-action="Index">Dashboard</a>
                <a class="list-group-item list-group-item-action @(currentAction == "Orders" || currentAction == "OrderDetails" ? "active" : "")" asp-controller="Admin" asp-action="Orders">Orders</a>
                <a class="list-group-item list-group-item-action @(currentAction is "Products" or "ProductCreate" or "ProductEdit" ? "active" : "")" asp-controller="Admin" asp-action="Products">Products</a>
                <a class="list-group-item list-group-item-action @(currentAction == "Categories" ? "active" : "")" asp-controller="Admin" asp-action="Categories">Categories</a>
                <a class="list-group-item list-group-item-action @(currentAction == "Settings" || currentAction == "DeliveryZones" ? "active" : "")" asp-controller="Admin" asp-action="Settings">Settings</a>
                <a class="list-group-item list-group-item-action" asp-controller="Home" asp-action="Index">View Site</a>
            </div>
        </div>
    </div>

    <div class="admin-shell">
        <aside class="admin-sidebar d-none d-md-block">
            <div class="list-group list-group-flush">
                <a class="list-group-item list-group-item-action @(currentAction == "Index" ? "active" : "")" asp-controller="Admin" asp-action="Index">Dashboard</a>
                <a class="list-group-item list-group-item-action @(currentAction == "Orders" || currentAction == "OrderDetails" ? "active" : "")" asp-controller="Admin" asp-action="Orders">Orders</a>
                <a class="list-group-item list-group-item-action @(currentAction is "Products" or "ProductCreate" or "ProductEdit" ? "active" : "")" asp-controller="Admin" asp-action="Products">Products</a>
                <a class="list-group-item list-group-item-action @(currentAction == "Categories" ? "active" : "")" asp-controller="Admin" asp-action="Categories">Categories</a>
                <a class="list-group-item list-group-item-action @(currentAction == "Settings" || currentAction == "DeliveryZones" ? "active" : "")" asp-controller="Admin" asp-action="Settings">Settings</a>
                <a class="list-group-item list-group-item-action" asp-controller="Home" asp-action="Index">View Site</a>
            </div>
        </aside>
        <main class="admin-main">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success">@TempData["Message"]</div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
