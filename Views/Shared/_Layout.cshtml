@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@inject ECommerceSite.Services.ICartService CartService
@{
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var cartItemCount = (await CartService.GetCartItemsAsync(ECommerceSite.Helpers.CartCookie.GetOrCreateCartId(Context))).Count;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content="@antiforgeryToken" />
    <title>@ViewData["Title"] - Local Pork Delivery</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">🐷 Local Pork Delivery</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <div class="navbar-nav ms-auto">
                    <a class="nav-link text-white" asp-controller="Order" asp-action="MyOrders">My Orders</a>
                    <a class="nav-link text-white" asp-controller="Cart" asp-action="Index">🛒 Cart <span id="cart-count-badge" class="badge rounded-pill bg-success @(cartItemCount == 0 ? "d-none" : "")">@cartItemCount</span></a>
                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <a class="nav-link text-white" asp-controller="Admin" asp-action="Index">Admin Panel</a>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-link nav-link text-white">Logout</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </nav>

    <div class="container">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success">@TempData["Message"]</div>
        }
        @RenderBody()
    </div>

    <div id="cart-toast" class="toast align-items-center text-bg-success border-0 position-fixed bottom-0 end-0 m-3" role="status" aria-live="polite" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">✅ Added to cart</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>

    <partial name="_Footer" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const cartBadge = document.getElementById('cart-count-badge');
            const cartToast = document.getElementById('cart-toast');
            const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';

            const updateCartBadge = (count) => {
                if (!cartBadge) return;
                cartBadge.textContent = count;
                cartBadge.classList.toggle('d-none', !count);
            };

            document.addEventListener('submit', async function (event) {
                const form = event.target.closest('.js-add-to-cart');
                if (!form) return;

                event.preventDefault();
                const button = form.querySelector('button[type="submit"]');
                if (button) button.disabled = true;
                const payload = new URLSearchParams();
                payload.set('productId', form.querySelector('input[name="productId"]')?.value || '');
                payload.set('quantity', form.querySelector('input[name="quantity"]')?.value || '1');
                payload.set('__RequestVerificationToken', form.querySelector('input[name="__RequestVerificationToken"]')?.value || csrfToken);

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': payload.get('__RequestVerificationToken'),
                            'X-Requested-With': 'XMLHttpRequest',
                            'Accept': 'application/json',
                            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                        },
                        body: payload.toString()
                    });
                    const data = await response.json();
                    if (!response.ok || !data.success) {
                        throw new Error(data.message || 'Unable to add this product to your cart.');
                    }

                    updateCartBadge(data.itemCount);
                    if (cartToast && window.bootstrap) {
                        bootstrap.Toast.getOrCreateInstance(cartToast, { delay: 2200 }).show();
                    }
                } catch (error) {
                    window.alert(error.message || 'Unable to add this product to your cart.');
                } finally {
                    if (button) button.disabled = false;
                }
            });
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
