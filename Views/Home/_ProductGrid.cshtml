@model List<Product>

@if (!Model.Any())
{
    <p class="text-center text-muted">No products available right now. Please check back soon.</p>
}

<div class="row">
    @foreach (var product in Model)
    {
        <div class="col-6 col-md-4 mb-4">
            <div class="card h-100 product-card">
                @if (!string.IsNullOrEmpty(product.ImageUrl))
                {
                    <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height:180px;object-fit:cover;" />
                }
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title mb-1">@product.Name</h5>
                    <div class="price-tag mb-2">Rs. @product.PricePerKg <span class="small text-muted fw-normal">/ KG</span></div>
                    <span class="available-badge mb-3">Available on Order</span>
                    <div class="d-flex gap-2 mt-auto">
                        <a class="btn btn-outline-primary flex-grow-1" asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">View</a>
                        <form asp-controller="Cart" asp-action="Add" method="post" class="js-add-to-cart">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@product.Id" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn btn-success" aria-label="Add @product.Name to cart">+</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
